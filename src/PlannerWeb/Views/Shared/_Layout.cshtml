<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Планер")</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/planner.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <div id="status" role="status" aria-live="polite" hidden></div>
    <script src="~/js/planner.js" asp-append-version="true" defer></script>
</body>
</html>
